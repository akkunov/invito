# Development sample only. Never commit real passwords, JWTs or R2 secrets.
DATABASE_URL="postgresql://invito:invito_dev_only@localhost:5432/invito?schema=public"
DIRECT_DATABASE_URL="postgresql://invito:invito_dev_only@localhost:5432/invito?schema=public"
# Supabase: runtime transaction pooler :6543, migration session pooler :5432.
# Copy each URI directly from Supabase Connect. Add sslmode=require when using hosted DB.
DATABASE_POOL_MAX=3
PORT=4000
FRONTEND_ORIGINS="http://localhost:3000"
# Only for local development. In production API docs require explicit true.
API_DOCS_ENABLED=true

AUTH_ISSUER="http://localhost:8080/realms/invito"
AUTH_AUDIENCE="invito-api"
AUTH_JWKS_URL="http://localhost:8080/realms/invito/protocol/openid-connect/certs"
AUTH_PROVIDER_ID="keycloak-local"

R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Omit R2_ENDPOINT if using the default Cloudflare R2 region.

RSVP_TURNSTILE_SITE_KEY=""
RSVP_TURNSTILE_SECRET=""
