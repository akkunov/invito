# Separate, disposable development DB. Never commit real connection strings.
DATABASE_URL="postgresql://invito:invito_dev_only@localhost:5432/invito?schema=public"
DIRECT_DATABASE_URL="postgresql://invito:invito_dev_only@localhost:5432/invito?schema=public"
PORT=4000
# OIDC access tokens must be RS256 JWTs with issuer, audience and sub.
# A missing OIDC configuration fails closed: private endpoints return 503.
AUTH_ISSUER="https://identity.example.org/"
AUTH_AUDIENCE="invito-api"
AUTH_JWKS_URL="https://identity.example.org/.well-known/jwks.json"
AUTH_PROVIDER_ID="oidc-primary"
FRONTEND_ORIGINS="http://localhost:3000"

# Private Cloudflare R2 bucket. Never expose these values as NEXT_PUBLIC_*.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Optional S3 endpoint for regional R2 jurisdictions, e.g. https://<account>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=""
\n# Production guest RSVP requires BOTH keys; the secret is backend-only.\nRSVP_TURNSTILE_SITE_KEY=""\nRSVP_TURNSTILE_SECRET=""\n