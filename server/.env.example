# Development sample only. Never commit real passwords, JWTs or R2 secrets.
DATABASE_URL="postgresql://invito:invito_dev_only@localhost:5432/invito?schema=public"
DIRECT_DATABASE_URL="postgresql://invito:invito_dev_only@localhost:5432/invito?schema=public"
# Supabase runtime Transaction pooler :6543; Prisma Migrate Session pooler :5432.
# Use an SSL connection string from the project's Connect dialog.
DATABASE_POOL_MAX=3
PORT=4000
FRONTEND_ORIGINS="http://localhost:3000"
API_DOCS_ENABLED=true

# Supabase Auth: use asymmetric ES256 or RS256 JWT Signing Keys (NOT legacy HS256).
AUTH_ISSUER="https://YOUR_PROJECT_REF.supabase.co/auth/v1"
AUTH_AUDIENCE="authenticated"
AUTH_JWKS_URL="https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"
AUTH_PROVIDER_ID="supabase"

R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
RSVP_TURNSTILE_SITE_KEY=""
RSVP_TURNSTILE_SECRET=""
